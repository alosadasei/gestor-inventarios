DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Solo en producción (Azure App Service): rutas fuera de /home/site/wwwroot,
# que se sobrescribe en cada despliegue.
# DJANGO_DB_PATH=/home/inventario.db
# DJANGO_MEDIA_ROOT=/home/media

# Email (código de acceso en el login y recuperación de contraseña).
# Si se deja vacío, los correos se imprimen en la consola (útil en local).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu_cuenta@gmail.com
# EMAIL_HOST_PASSWORD=contraseña de aplicación de Gmail
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Inventario <noreply@example.com>
